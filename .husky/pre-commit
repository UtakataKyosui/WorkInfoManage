echo "🔍 Running pre-commit checks..."

# Rust checks
echo "[1/3] Running cargo fmt check..."
if ! cargo fmt -- --check; then
    echo "❌ Code formatting check failed. Run 'cargo fmt' to fix."
    exit 1
fi

echo "[2/3] Running cargo clippy..."
# Check library and main binary only, skip web_demo (WASM-only)
if ! cargo clippy --lib --bin work-info-manage --all-features 2>&1 | grep -q "error:"; then
    echo "✅ Clippy check passed (no errors)"
else
    echo "❌ Clippy found errors. Please fix them before committing."
    cargo clippy --lib --bin work-info-manage --all-features
    exit 1
fi

echo "[3/3] Running cargo test..."
if ! cargo test --lib --quiet 2>&1; then
    echo "❌ Tests failed. Please fix them before committing."
    exit 1
fi

echo "✅ All pre-commit checks passed!"
