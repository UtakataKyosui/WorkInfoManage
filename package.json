{
  "name": "workinfomanage",
  "version": "1.0.0",
  "description": "AsanaとGitHubを統合したタスク管理TUIアプリケーション。タスクの進捗状況をリアルタイムで可視化し、PRレビューの状態を自動的に反映します。",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UtakataKyosui/WorkInfoManage.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/UtakataKyosui/WorkInfoManage/issues"
  },
  "homepage": "https://github.com/UtakataKyosui/WorkInfoManage#readme",
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "husky": "^9.1.7",
    "typescript": "^5.9.3"
  }
}
