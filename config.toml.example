# TaskManager Configuration

[storage]
# Storage type: "json" or "database"
type = "json"

# JSON storage configuration (when type = "json")
# Path is fixed to ~/task-manage/data.json
# No additional configuration needed

# Database storage configuration (when type = "database")
# Uncomment and configure the following to use database storage:
# [storage]
# type = "database"
# url = "${DATABASE_URL}"
